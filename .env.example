# Database — PostgreSQL via Docker per DESIGN.md
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llm_usage_tracker

# App
PORT=3000
NODE_ENV=development

# Stripe test mode — never commit real keys (see docs/research/stripe-integration.md)
# Get test keys via: stripe sandbox create --from-git  or  stripe login
STRIPE_SECRET_KEY=sk_test_...replace_with_stripe_sandbox_secret...
STRIPE_PUBLISHABLE_KEY=pk_test_...replace_with_publishable...
STRIPE_WEBHOOK_SECRET=whsec_...replace_with_output_of_stripe_listen_--print-secret...

# Stripe Products/Prices — created via stripe products/prices create (see stripe-ids below)
# Free uses price 0; Pro is /month. Copy IDs from stripe CLI or dashboard.
STRIPE_PRODUCT_FREE=prod_...free...
STRIPE_PRICE_FREE=price_...free_monthly...
STRIPE_PRODUCT_PRO=prod_...pro...
STRIPE_PRICE_PRO=price_...pro_monthly...

# Pricing constants are in src/config/pricing.ts (integer micro-cents), not env

